[Unit]
Description=tomato-chat (NoneBot2 QQ bot)
Documentation=https://github.com/Nekobrush/tomato-chat-v2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust these two lines to where you cloned the project and which user runs it.
WorkingDirectory=/opt/tomato-chat
User=tomato
ExecStart=/opt/tomato-chat/.venv/bin/python main.py
Restart=on-failure
RestartSec=5

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1

# Basic hardening: the bot only needs to write its own data and logs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tomato-chat/data /opt/tomato-chat/logs

[Install]
WantedBy=multi-user.target
