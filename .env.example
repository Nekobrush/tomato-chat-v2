# 复制为 .env 后按需修改：copy .env.example .env
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8765
LOG_LEVEL=INFO

# 管理员（旧版的 super_admin_users + admin_users 合并到这里）
SUPERUSERS=["114514", "1919810"]

# 指令前缀（与 bot_config.COMMAND_PREFIXES 保持一致）
COMMAND_START=["/", "!", "！", "y", "tomato"]

# 反向 WebSocket 的 access token / secret，留空表示不校验
ONEBOT_ACCESS_TOKEN=
ONEBOT_SECRET=
